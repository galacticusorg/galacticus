<?xml version="1.0" encoding="UTF-8"?>
<!-- Host + subhalo pair used by testSuite/test-ram-pressure-koppen2018.py (and identical to that used by
     test-ram-pressure-history.py, except that the satellite carries a gaseous disk). The host carries a hot halo which supplies the
     ram pressure; the satellite is on an eccentric orbit, so that the ram pressure it experiences varies strongly along the orbit.

     The gas disk of the satellite is a test mass (1e6 Msun), and the satellite's own hot halo is negligible, so that the
     gravitational potential of the satellite is that of its NFW halo alone, allowing the test to compute the stripping criterion
     independently. The masses of the host's hot halo are scaled down (from 1e11 Msun) in proportion to the disk mass. -->
<tree>
  <!-- Host halo at the initial time. -->
  <node>
    <index>1</index>
    <parent>2</parent>
    <firstChild>-1</firstChild>
    <sibling>-1</sibling>
    <firstSatellite>3</firstSatellite>
    <basic>
      <time>1.0</time>
      <mass>1.0e12</mass>
    </basic>
    <darkMatterProfile>
      <scale>0.0263</scale>
    </darkMatterProfile>
    <hotHalo>
      <!-- Host CGM: supplies the ram pressure force on the satellite. Outer
           radius equals the host virial radius, so the host itself is in the
           ordinary regime. -->
      <isInitialized>true</isInitialized>
      <mass>1.0e8</mass>
      <outerRadius>0.26312</outerRadius>
      <angularMomentum>1.0e8</angularMomentum>
    </hotHalo>
  </node>
  <!-- Host halo at the final time (no growth: static universe, zero accretion). -->
  <node>
    <index>2</index>
    <parent>-1</parent>
    <firstChild>1</firstChild>
    <sibling>-1</sibling>
    <basic>
      <time>7.0</time>
      <mass>1.0e12</mass>
    </basic>
    <darkMatterProfile>
      <scale>0.0263</scale>
    </darkMatterProfile>
    <hotHalo>
      <isInitialized>true</isInitialized>
      <mass>1.0e8</mass>
      <outerRadius>0.26312</outerRadius>
      <angularMomentum>1.0e8</angularMomentum>
    </hotHalo>
  </node>
  <!-- Satellite, on an eccentric orbit inside the host virial radius. -->
  <node>
    <index>3</index>
    <parent>1</parent>
    <firstChild>-1</firstChild>
    <sibling>-1</sibling>
    <basic>
      <time>1.0</time>
      <!-- The satellite falls in at the start of the run: the virialOrbit ram pressure history class integrates from this time. -->
      <timeLastIsolated>1.0</timeLastIsolated>
      <mass>1.0e10</mass>
    </basic>
    <darkMatterProfile>
      <scale>0.0057</scale>
    </darkMatterProfile>
    <hotHalo>
      <isInitialized>true</isInitialized>
      <mass>1.0e3</mass>
      <outerRadius>0.05671</outerRadius>
      <angularMomentum>1.0e3</angularMomentum>
    </hotHalo>
    <disk>
      <massStellar>0.0</massStellar>
      <massGas>1.0e6</massGas>
      <abundancesStellar>
	<metals>0.0</metals>
      </abundancesStellar>
      <abundancesGas>
	<metals>0.0</metals>
      </abundancesGas>
      <angularMomentum>2.0e5</angularMomentum>
    </disk>
    <satellite>
      <boundMass>1.0e10</boundMass>
      <tidalHeatingNormalized>0.0</tidalHeatingNormalized>
      <position>0.15</position>
      <position>0.0</position>
      <position>0.0</position>
      <velocity>-60.0</velocity>
      <velocity>+60.0</velocity>
      <velocity>0.0</velocity>
      <tidalTensorPathIntegrated>
        <x00>0.0</x00>
        <x01>0.0</x01>
        <x02>0.0</x02>
        <x11>0.0</x11>
        <x12>0.0</x12>
        <x22>0.0</x22>
      </tidalTensorPathIntegrated>
      <mergeTime>-1.0</mergeTime>
      <destructionTime>-1.0</destructionTime>
      <virialOrbit>
        <radius>0.15</radius>
        <velocityRadial>-60.0</velocityRadial>
        <velocityTangential>60.0</velocityTangential>
        <massHost>1.0e12</massHost>
        <massSatellite>1.0e10</massSatellite>
      </virialOrbit>
    </satellite>
  </node>
</tree>
