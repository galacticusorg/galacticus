<?xml version='1.0' encoding='UTF-8'?>
<!-- Parameter file used by tests.hot_halo_outflow_stripping.exe, which validates the fraction of outflowing gas stripped from
     the hot halos of satellites against reference values.

     The virial density contrast is pinned to a fixed value, so that the test does not also depend on the spherical collapse
     solver. Each class is declared once, at the top level, so that the hot halo component and the outflow stripping class share
     a single instance of each.
  -->
<parameters>
  <formatVersion>2</formatVersion>
  <lastModified revision="b7f4fd1e25a2dc392718435937a0b7171f27c69b" time="2026-10-30T14:54:43"/>

  <cosmologyParameters value="simple">
    <HubbleConstant  value="67.36"  />
    <OmegaMatter     value="0.3153" />
    <OmegaDarkEnergy value="0.6847" />
    <OmegaBaryon     value="0.0493" />
    <temperatureCMB  value="2.72548"/>
  </cosmologyParameters>
  <cosmologyFunctions value="matterLambda"/>

  <virialDensityContrast value="fixed">
    <densityContrastValue value="200.0"/>
    <densityType          value="mean" />
  </virialDensityContrast>
  <darkMatterHaloScale value="virialDensityContrastDefinition"/>

  <!-- Node components. Only the basic and hot halo components are needed. -->
  <componentBasic   value="standard"/>
  <componentHotHalo value="standard"/>

  <!-- The hot halo mass distribution: a beta=2/3 profile with a core radius of 0.3 times the virial radius, matching the
       reference values. -->
  <hotHaloMassDistribution value="betaProfile">
    <beta value="0.666666666666666667"/>
  </hotHaloMassDistribution>
  <hotHaloMassDistributionCoreRadius value="virialFraction">
    <coreRadiusOverVirialRadius value="0.3"/>
  </hotHaloMassDistributionCoreRadius>
  <hotHaloTemperatureProfile value="virial"/>

  <!-- Outflow stripping. The efficiency must match that in the test. -->
  <hotHaloOutflowStripping value="standard">
    <efficiency value="0.25"/>
  </hotHaloOutflowStripping>
</parameters>
