    <parent>102</parent>
    <firstChild>-1</firstChild>
    <sibling>-1</sibling>
    <firstSatellite>103</firstSatellite>
    <basic>
      <time>8.0</time>
      <timeLastIsolated>8.0</timeLastIsolated>
      <mass>1.0e10</mass>
    </basic>
    <darkMatterProfile>
      <scale>6.7e-3</scale>
    </darkMatterProfile>
  </node>
  <node>
