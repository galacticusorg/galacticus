      <timeLastIsolated>8.1</timeLastIsolated>
      <mass>1.0e10</mass>
    </basic>
    <darkMatterProfile>
      <scale>6.7e-3</scale>
    </darkMatterProfile>
  </node>
  <!-- Inside the core radius. -->
  <node>
    <index>103</index>
    <parent>101</parent>
    <firstChild>-1</firstChild>
    <sibling>104</sibling>
    <basic>
      <time>8.0</time>
      <timeLastIsolated>8.0</timeLastIsolated>
      <mass>1.0e7</mass>
    </basic>
    <darkMatterProfile>
      <scale>6.5e-4</scale>
    </darkMatterProfile>
    <satellite>
      <boundMass>1.0e7</boundMass>
      <position>2.0e-4</position>
      <position>0.0</position>
      <position>0.0</position>
      <velocity>0.0</velocity>
      <velocity>20.0</velocity>
      <velocity>0.0</velocity>
      <virialOrbit>
        <radius>2.0e-4</radius>
        <velocityRadial>0.0</velocityRadial>
        <velocityTangential>20.0</velocityTangential>
        <massHost>1.0e10</massHost>
        <massSatellite>1.0e7</massSatellite>
      </virialOrbit>
      <tidalHeatingNormalized>0.0</tidalHeatingNormalized>
      <tidalTensorPathIntegrated>
        <x00>0.0</x00><x01>0.0</x01><x02>0.0</x02>
        <x11>0.0</x11><x12>0.0</x12><x22>0.0</x22>
      </tidalTensorPathIntegrated>
      <mergeTime>-1.0</mergeTime>
      <destructionTime>-1.0</destructionTime>
    </satellite>
  </node>
  <!-- Between the core and soliton radii. -->
  <node>
    <index>104</index>
    <parent>101</parent>
    <firstChild>-1</firstChild>
    <sibling>105</sibling>
