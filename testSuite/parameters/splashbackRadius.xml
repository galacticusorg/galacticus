<?xml version='1.0' encoding='UTF-8'?>
<!-- Compute the halo mass function, including splashback radii and masses. Used by testSuite/test-splashback-radius.py -->

<parameters>
  <formatVersion>2</formatVersion>
  <lastModified revision="a3e1665914d944c9fa844f662a028072e84740a5" time="2026-07-28T17:29:21"/>

  <!-- Specify tasks to perform -->
  <task value="haloMassFunction">
    <haloMassMinimum value="1.0e12"/>
    <haloMassMaximum value="1.0e15"/>
    <pointsPerDecade value="4"/>
    <includeMassAccretionRate value="true"/>
    <includeSplashbackRadius value="true"/>
  </task>

  <!-- Cosmological parameters -->
  <cosmologyFunctions value="matterLambda"/>
  <cosmologyParameters value="simple">
    <HubbleConstant value="70.20000"/>
    <OmegaMatter value=" 0.27250"/>
    <OmegaDarkEnergy value=" 0.72750"/>
    <OmegaBaryon value=" 0.04550"/>
    <temperatureCMB value=" 2.72548"/>
  </cosmologyParameters>

  <!-- Power spectrum options -->
  <transferFunction value="eisensteinHu1999">
    <neutrinoNumberEffective value="3.046"/>
    <neutrinoMassSummed value="0.000"/>
  </transferFunction>
  <powerSpectrumPrimordial value="powerLaw">
    <index value="0.961"/>
    <wavenumberReference value="1.000"/>
    <running value="0.000"/>
  </powerSpectrumPrimordial>
  <powerSpectrumPrimordialTransferred value="simple"/>
  <cosmologicalMassVariance value="filteredPower">
    <sigma_8 value="0.807"/>
  </cosmologicalMassVariance>

  <!-- Structure formation options -->
  <linearGrowth value="collisionlessMatter"/>
  <haloMassFunction value="tinker2008"/>
  <criticalOverdensity value="sphericalCollapseClsnlssMttrCsmlgclCnstnt"/>
  <virialDensityContrast value="sphericalCollapseClsnlssMttrCsmlgclCnstnt"/>

  <!-- Dark matter halo structure options -->
  <darkMatterProfileDMO value="NFW"/>
  <darkMatterProfileConcentration value="gao2008"/>

  <!-- Mass accretion histories. The Diemer (2020) fit directly parameterizes the accretion rate averaged over a dynamical
       time, which is the quantity against which the Diemer (2020) splashback model was calibrated. -->
  <darkMatterHaloMassAccretionHistory value="diemer2020"/>

  <!-- Splashback radii -->
  <darkMatterHaloSplashbackRadius value="diemer2020">
    <definition value="mean"/>
  </darkMatterHaloSplashbackRadius>

  <!-- Output options -->
  <outputFileName value="testSuite/outputs/splashbackRadius.hdf5"/>
  <outputTimes value="list">
    <redshifts value="0.0 1.0"/>
  </outputTimes>

</parameters>
