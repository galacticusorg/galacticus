<?xml version='1.0' encoding='UTF-8'?>
<!-- Parameters for testing the observational selection function applied to Local Group satellites. -->

<!-- A deliberately small, low-resolution model: this tests the machinery which applies the selection    -->

<!-- function, not the physics of the satellite population.                                             -->

<parameters>
  <formatVersion>2</formatVersion>
  <lastModified revision="f88a96423e21da1fe340565b2036399633246e13" time="2026-10-22T05:48:31"/>


  <!-- Include required parameters -->
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/darkMatterParticleCDM.xml"       xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/cosmology.xml"                   xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/powerSpectrum.xml"               xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/structureFormation.xml"          xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/darkMatterHalosProfile.xml"      xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/darkMatterHalosTidalHeating.xml" xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/darkMatterHalosStructure.xml"    xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/subhaloOrbits.xml"               xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/mergerTrees.xml"                 xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/filterLMC.xml"                   xpointer="xpointer(parameters/*)" />
  <xi:include xmlns:xi="http://www.w3.org/2001/XInclude" href="../../parameters/reference/evolutionGalaxyFormation.xml"    xpointer="xpointer(parameters/*)" />

  <!-- Set verbosity to standard level. -->
  <verbosityLevel value="standard"/>

  <!-- Set up the tasks to perform. -->
  <task value="evolveForests">
    <!-- Evolve merger tree forests. -->
  </task>

  <!-- Merger tree building options -->
  <mergerTreeBuildMasses value="fixedMass">
    <!-- Halo masses fixed at a single value. -->
    <!-- The value used is the joint (RR Lyrae + blue horizontal branch) estimate of M200c=1.19(+0.14/-0.12)e12 Msun from DESI DR2 (DESI
         Collaboration, Aganze et al. 2026; https://arxiv.org/abs/2611.05518). It is imposed as the mass enclosed within R200c=0.2243 Mpc
         (the value of R200c for this mass in the reference cosmology). This matches M200c for the halo profile assigned when the tree
         is constructed (approximately the mean concentration-mass relation). The host's final concentration differs from tree to tree, so its z=0
         M200c is typically ~2% lower (0.94-1.01 times the target in a sample of 24 trees). Note that the joint estimate is weighted ~75% to the GME method - excluding GME gives
         M200c=1.52(+0.35/-0.30)e12 Msun. -->
    <massTree   value="1.190e12"/>
    <radiusTree value="0.2243e00"/>
    <treeCount  value="4"       />
  </mergerTreeBuildMasses>

  <!-- Halo mass resolution -->
  <mergerTreeMassResolution value="fixed">
    <!-- All trees are set to have the same halo mass resolution. -->
    <!-- A relatively coarse mass resolution is used to allow the model to run in reasonable time. -->
    <massResolution value="3.0e8"/>
  </mergerTreeMassResolution>

  <!-- Output epochs -->
  <outputTimes value="list">
    <!-- Additional redshifts can be added to this list to generate more outputs. -->
    <redshifts value="0.0"/>
  </outputTimes>

  <!-- Luminosities -->
  <!-- The V-band luminosity is required by the observational selection function applied to Local Group satellites. -->
  <luminosityFilter   value="Buser_V"/>
  <luminosityType     value="rest"   />
  <luminosityRedshift value="0.0"    />

  <!-- Analyses -->
  <mergerTreeOutputter value="multi">
    <mergerTreeOutputter value="analyzer"/>
    <mergerTreeOutputter value="standard">
      <!-- The properties used by the `localGroupDetection` weight operator, so that the detection -->
      <!-- probabilities it applies can be recomputed independently.                              -->
      <nodePropertyExtractor value="multi">
        <nodePropertyExtractor value="nodeIndices"          />
        <nodePropertyExtractor value="radiusOrbital"        />
        <nodePropertyExtractor value="radiusHalfMassStellar"/>
        <nodePropertyExtractor value="treeWeight"           />
        <nodePropertyExtractor value="luminosityStellar"     >
          <filterName value="Buser_V"/>
          <filterType value="rest"   />
        </nodePropertyExtractor>
      </nodePropertyExtractor>
    </mergerTreeOutputter>
  </mergerTreeOutputter>
  <outputAnalysis      value="localGroupLuminosityFunction">
    <positionType                     value="orbital"/>
    <logLikelihoodZero                value="0.0"    />
    <randomErrorMinimum               value="1.0e-6" />
    <randomErrorMaximum               value="1.0e-6" />
    <randomErrorPolynomialCoefficient value="0.0"    />
  </outputAnalysis>
  <elementsToTrack value="Fe"/>

  <!-- Output file -->
  <outputFileName value="testSuite/outputs/test-Local-Group-selection-function.hdf5"/>

</parameters>
