<?xml version='1.0' encoding='UTF-8'?>
<parameters formatVersion="2" version="0.9.4">
  <!-- Exercises the proposed-state log and the step labelling of sampled model  -->
  <!-- vectors written by `posteriorSampleLikelihoodHaloMassFunction`.           -->
  <!--                                                                          -->
  <!-- `[logProposals]` writes every evaluated proposal, accepted or not, which  -->
  <!-- is the only place a rejected proposal's parameters are recorded.          -->
  <!-- `[pathSamples]` writes the model mass function at each likelihood         -->
  <!-- evaluation, tagged with the simulation step; that tag must agree with the -->
  <!-- step recorded in the chain log, or the two cannot be joined.              -->
  <!--                                                                          -->
  <!-- Driven by testSuite/test-posteriorSampleProposalLog_MPI.py.               -->
  <formatVersion>2</formatVersion>
  <outputFileName value="testSuite/outputs/posteriorSampleProposalLog.hdf5" />

  <posteriorSampleLikelihood value="haloMassFunction">
    <baseParametersFileName value="testSuite/parameters/posteriorSampleProposalLogParameters.xml"/>
    <binCountMinimum        value="0" />
    <fileNames              value="%DATASTATICPATH%/darkMatter/Symphony/MilkyWay/resolutionX1/CDM/Halo004/haloMassFunction_z0.000.hdf5" />
    <likelihoodPoisson      value="true" />
    <massRangeMaximum       value="1.03214e+11" />
    <massRangeMinimum       value="1.20849e+09" />
    <redshifts              value="0.00000e+00" />
    <!-- Record the model mass function at every likelihood evaluation. -->
    <pathSamples            value="testSuite/outputs/posteriorSampleProposalLogSamples" />
    <appendSamples          value="false" />
  </posteriorSampleLikelihood>

  <posteriorSampleSimulation value="differentialEvolution">
    <acceptanceAverageCount value="10" />
    <logFileRoot            value="testSuite/outputs/posteriorSampleProposalLogChains" />
    <logFlushCount          value="1" />
    <!-- Record every proposal, whether or not it is accepted. -->
    <logProposals           value="true" />
    <!-- Two chains suffice here; the usual advice of at least as many chains as
         parameters is about sampling quality, which this test does not assess. -->
    <ignoreChainNumberAdvice value="true" />

    <modelParameter value="active">
      <name value="haloMassFunctionParameters/a" />
      <distributionFunction1DPerturber value="cauchy">
        <median value="0.0"    />
        <scale  value="1.0e-2" />
      </distributionFunction1DPerturber>
      <distributionFunction1DPrior value="uniform">
        <limitLower value="0.30" />
        <limitUpper value="3.00" />
      </distributionFunction1DPrior>
      <operatorUnaryMapper value="identity" />
    </modelParameter>
    <modelParameter value="active">
      <name value="haloMassFunctionParameters/normalization" />
      <distributionFunction1DPerturber value="cauchy">
        <median value="0.0"    />
        <scale  value="1.0e-2" />
      </distributionFunction1DPerturber>
      <distributionFunction1DPrior value="uniform">
        <limitLower value="0.10" />
        <limitUpper value="1.00" />
      </distributionFunction1DPrior>
      <operatorUnaryMapper value="identity" />
    </modelParameter>

    <posteriorSampleConvergence value="gelmanRubin">
      <burnCount                  value="10" />
      <logFileName                value="testSuite/outputs/posteriorSampleProposalLog.convergence.log" />
      <outlierCountMaximum        value="0" />
      <outlierLogLikelihoodOffset value="60" />
      <outlierSignificance        value="0.95" />
      <reportCount                value="1" />
      <testCount                  value="20" />
      <thresholdHatR              value="1.20" />
    </posteriorSampleConvergence>

    <posteriorSampleDffrntlEvltnProposalSize value="adaptive">
      <logFileName           value="testSuite/outputs/posteriorSampleProposalLog.proposalSize.log"/>
      <acceptanceRateMaximum value="0.90e+0" />
      <acceptanceRateMinimum value="0.10e+0" />
      <gammaAdjustFactor     value="1.10e+0" />
      <gammaInitial          value="0.50e+0" />
      <gammaMaximum          value="3.00e+0" />
      <gammaMinimum          value="1.00e-2" />
      <updateCount           value="10" />
    </posteriorSampleDffrntlEvltnProposalSize>

    <posteriorSampleDffrntlEvltnRandomJump value="adaptive" />

    <posteriorSampleState value="correlation">
      <acceptedStateCount value="100" />
    </posteriorSampleState>

    <posteriorSampleStateInitialize value="latinHypercube">
      <maximinTrialCount value="100" />
    </posteriorSampleStateInitialize>

    <!-- Run a fixed number of steps: the test checks bookkeeping, not convergence. -->
    <posteriorSampleStoppingCriterion value="stepCount">
      <stopAfterCount value="40" />
    </posteriorSampleStoppingCriterion>

    <reportCount    value="10" />
    <sampleOutliers value="false" />
    <stateSwapCount value="10" />
    <stepsMaximum   value="40" />
  </posteriorSampleSimulation>

  <randomNumberGenerator value="GSL">
    <mpiRankOffset value="true" />
    <seed          value="219" />
  </randomNumberGenerator>

  <task value="posteriorSample">
    <initializeNodeClassHierarchy value="true" />
  </task>

  <verbosityLevel value="standard" />
</parameters>
