<!-- Reference subhalo orbits model -->

<parameters>
  <formatVersion>2</formatVersion>
  <lastModified revision="f88a96423e21da1fe340565b2036399633246e13" time="2026-10-22T05:48:31"/>


  <!-- Satellite orbit options -->
  <virialOrbit value="spinCorrelated">
    <!-- Best fit value for correlation with host spin from https://github.com/galacticusorg/galacticus/wiki/Constraints:-Halo-spins-and-concentrations. -->
    <alpha value="0.155573112534425" />
    <virialOrbit value="jiang2014" >
      <!-- Best fit value from Benson, Behrens, & Lu (2020) -->
      <bRatioHigh             value="+2.88333 +4.06371 +3.86726"/>
      <bRatioIntermediate     value="+1.05361 +1.56868 +2.89027"/>
      <bRatioLow              value="+0.07432 +0.54554 +1.04721"/>
      <gammaRatioHigh         value="+0.07124 +0.04737 -0.01913"/>
      <gammaRatioIntermediate value="+0.10069 +0.07821 +0.04231"/>
      <gammaRatioLow          value="+0.10866 +0.11260 +0.11698"/>
      <muRatioHigh            value="+1.10168 +1.09639 +1.09819"/>
      <muRatioIntermediate    value="+1.18205 +1.19573 +1.24581"/>
      <muRatioLow             value="+1.22053 +1.22992 +1.25528"/>
      <sigmaRatioHigh         value="+0.09244 +0.14335 +0.21079"/>
      <sigmaRatioIntermediate value="+0.07397 +0.09590 +0.10941"/>
      <sigmaRatioLow          value="+0.07458 +0.09040 +0.06981"/>
    </virialOrbit>
  </virialOrbit>
 
  <!-- Orbiting model of satellites -->
  <!-- The dynamical friction Coulomb logarithm is the value of Yang et al. (2020; MNRAS; 498; 3902;
       http://adsabs.harvard.edu/abs/2020MNRAS.498.3902Y) for their gamma=0 case (using the Caterpillar simulations as calibration
       target), consistent with the gamma=0 tidal heating rate used below. Du et al. (2024) adjusted the Coulomb logarithm for each
       of their idealized simulations to match the measured orbits, noting that this does not significantly affect their
       calibration, and give no value for use in cosmological models. -->
  <satelliteDynamicalFriction value="massRatioThreshold">
    <!-- Allow for includer files to set a mass ratio threshold for dynamical friction - defaulting to zero if none is given. -->
    <massRatioThreshold value="=[satelliteDynamicalFrictionMassRatioThreshold|0.0]"/>
    <satelliteDynamicalFriction value="chandrasekhar1943">
      <logarithmCoulomb value="1.53"/>
    </satelliteDynamicalFriction>
  </satelliteDynamicalFriction>
  <!-- Tidal heating and stripping parameters are the best fit values for NFW (gamma=1) subhalos from Du et al. (2024; PRD; 110;
       023019; https://arxiv.org/abs/2403.09597), found by matching tidal tracks of idealized N-body simulations of orbiting
       subhalos. These are the values used in testSuite/parameters/idealizedSubhaloSimulations/. The heating decay efficiency, and
       the second order heating coefficient, that complete this calibration are set in evolutionDarkMatterOnly.xml,
       evolutionGalaxyFormation.xml, and darkMatterHalosTidalHeating.xml. -->
  <satelliteTidalHeatingRate  value="gnedin1999"       >
    <epsilon          value="0.0732225"/>
    <gamma            value="0.0"      />
  </satelliteTidalHeatingRate>
  <satelliteTidalStripping    value="zentner2005"      >
    <useDynamicalTimeScale value="true"   />
    <efficiency            value="3.82024"/>
  </satelliteTidalStripping>
  <satelliteTidalStrippingRadius value="king1962">
    <efficiencyCentrifugal value="0.0"/>
  </satelliteTidalStrippingRadius>
  <satelliteTidalField value="standard"/>

  <!-- Substructure hierarchy options -->
  <mergerTreeNodeMerger value="multiLevelHierarchy"/>
  <dynamicalFrictionGaseous value="chandrasekhar1943"/>
  <kinematicsDistributionInterstellarMedium value="local"/>

</parameters>
