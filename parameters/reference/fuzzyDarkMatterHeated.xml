<?xml version="1.0" encoding="UTF-8"?>
<!-- A set of changes to modify CDM reference parameter files to use a fuzzy dark matter particle. -->
<changes>

  <!-- Change the dark matter particle to a fuzzy dark matter particle -->
  <change type="replace" path="darkMatterParticle">
    <darkMatterParticle value="fuzzyDarkMatter">
      <mass            value="10.0"/> <!-- In unis of 1.0e-22 eV -->
      <densityFraction value=" 1.0"/>
    </darkMatterParticle>
  </change>

  <!-- Replace the transfer function with one generated from AxionCAMB (https://github.com/dgrin1/axionCAMB). -->
  <!-- Make a temporary copy of the cosmological parameters passed to the transfer function. -->
  <change type="append" path="">
    <axionCAMBTmp>
      <cosmologyParameters/>
    </axionCAMBTmp>
  </change>
  <change type="replaceWith" path="axionCAMBTmp/cosmologyParameters" target="transferFunction/cosmologyParameters"/>
  <!-- Replace the transfer function with AxionCAMB. -->
  <change type="replace" path="transferFunction">
    <transferFunction value="axionCAMB">
      <cosmologyParameters/>
    </transferFunction>
  </change>
  <!-- Restore the original cosmological parameters into the transfer function. -->
  <change type="replaceWith" path="transferFunction/cosmologyParameters" target="axionCAMBTmp/cosmologyParameters"/>
  <change type="remove" path="axionCAMBTmp"/>

  <!-- Copy the concentration scale-radius model out of the Johnson (2021) wrapper. -->
  <change type="append" path="darkMatterProfileScaleRadius">
    <darkMatterProfileScaleRadius value="concentration"/>
  </change>

  <change type="replaceWith" path="darkMatterProfileScaleRadius/darkMatterProfileScaleRadius[@value='concentration']" target="darkMatterProfileScaleRadius/darkMatterProfileScaleRadius[@value='johnson2021']/darkMatterProfileScaleRadius[@value='concentration']"/>

  <!-- Allow lower halo concentrations for fuzzy dark matter. -->
  <change type="update" path="darkMatterProfileScaleRadius/concentrationMinimum" value="0.1"/>

  <!-- Remove the Johnson (2021) wrapper only after its required children have been copied. -->
  <change type="remove" path="darkMatterProfileScaleRadius/darkMatterProfileScaleRadius[@value='johnson2021']"/>

  <change type="update"  path="darkMatterProfileScaleRadius/darkMatterProfileScaleRadius/darkMatterProfileConcentration/reference/darkMatterProfileConcentration/truncateConcentration" value="true"/>

  <change type="update" path="darkMatterProfileScaleRadius/darkMatterProfileScaleRadius/darkMatterProfileConcentration/reference/darkMatterProfileConcentration/includeUpturn" value="false"/>

  <!-- Use the soliton+NFW mass distribution for dark matter halo profiles, except in places where we have models calibrated to
       use the NFW profile. -->
  <change type="append" path="darkMatterProfileScaleRadius">
    <darkMatterProfileDMO/>
  </change>

  <change type="append" path="nodeOperator/nodeOperator[@value='haloAngularMomentumVitvitska2002']">
    <darkMatterProfileDMO/>
  </change>

  <change type="append" path="virialOrbit">
    <darkMatterProfileDMO/>
  </change>
  <change type="replaceWith" path="darkMatterProfileScaleRadius/darkMatterProfileDMO"                                         target="darkMatterProfileDMO/darkMatterProfileDMO"/>
  <change type="replaceWith" path="nodeOperator/nodeOperator[@value='haloAngularMomentumVitvitska2002']/darkMatterProfileDMO" target="darkMatterProfileDMO/darkMatterProfileDMO"/>
  <change type="replaceWith" path="virialOrbit/darkMatterProfileDMO"                                                          target="darkMatterProfileDMO/darkMatterProfileDMO"/>

  <change type="replace" path="darkMatterProfileDMO[@value='heated']">
    <darkMatterProfileDMO value="solitonNFWHeated">
      <nonAnalyticSolver value="numerical"/>
      <toleranceRelativeVelocityDispersionMaximum value="0.1"/>
    </darkMatterProfileDMO>
  </change>

  <!-- Limit the tidal radius used for stripping the outer halo so that it can never enter the solitonic core. The inner tidal
       radius model must be given explicitly: "limited" composites a member of its own class, and Galacticus refuses to build
       such a member from defaults since that would recurse indefinitely. It is therefore stated once here and copied below to
       wherever else it is needed, so that this file has a single point of truth for it. Should the reference model ever specify
       an explicit tidal radius model of its own, use a change of type "encapsulate" on it instead, so that the model it
       specifies is moved inside this wrapper rather than being overridden by the one given here. -->
  <change type="append" path="satelliteTidalStripping">
    <satelliteTidalStrippingRadius value="limited">
      <satelliteTidalStrippingRadius value="king1962"/>
    </satelliteTidalStrippingRadius>
  </change>

  <!-- Tidal mass loss from satellites is handled by the soliton-aware operator added below, which dispatches to the outer halo
       or to the solitonic core according to the state of the halo. The standard operator would double-count that mass loss, and
       would additionally bypass the tidal radius limiter added above, so it is removed here. -->
  <change type="remove" path="nodeOperator/nodeOperator[@value='satelliteTidalMassLoss']"/>

  <!-- Add the soliton node operator for soliton+NFW dark matter halo profiles. -->
  <change type="append" path="nodeOperator">
    <nodeOperator value="darkMatterProfileSoliton"/>
  </change>

  <change type="append" path="nodeOperator">
    <nodeOperator value="satelliteConditionalMassLoss">
      <!-- The outer-halo stripping model is not specified here: it is inherited from the enclosing scope, so that it always
           matches the tidal stripping model used by the rest of the model, including the radius limiter added above. -->
      <satelliteTidalStrippingCore value="du2018"/>
      <satelliteTidalStrippingRadius/>
    </nodeOperator>
  </change>

  <!-- Give the soliton mass-loss operator a copy of the *unlimited* tidal radius model. It is used only to detect when the
       tidal radius first reaches the soliton radius: were it the limited model, the radius could never fall below the soliton
       radius and that transition would never be detected. -->
  <change type="replaceWith" path="nodeOperator/nodeOperator[@value='satelliteConditionalMassLoss']/satelliteTidalStrippingRadius" target="satelliteTidalStripping/satelliteTidalStrippingRadius[@value='limited']/satelliteTidalStrippingRadius"/>

</changes>
