<?xml version="1.0" encoding="UTF-8"?>
<!-- A set of changes to modify CDM reference parameter files to use a warm dark matter particle. -->
<changes>

  <!-- Change the dark matter particle to a WDM particle -->
  <change type="replace" path="darkMatterParticle">
    <darkMatterParticle value="WDMThermal">
      <degreesOfFreedomEffective value="1.5"/> <!-- Fiducial value from Bode et al. (2001;  http://adsabs.harvard.edu/abs/2001ApJ...556...93B).                                           -->
      <mass                      value="6.1"/> <!-- Chosen to match the 10:1 posterior odds ratio limit from Keeley et al. (2024; https://ui.adsabs.harvard.edu/abs/2024MNRAS.535.1652K). -->
    </darkMatterParticle>
  </change>

  <!-- Wrap the transfer function in one appropriate for warm dark matter. Specifically, the transfer function of Bode et
       al. (2001; http://adsabs.harvard.edu/abs/2001ApJ...556...93B) along with the fit to the cut-off scale from Vogel &
       Abazajian (2022; https://ui.adsabs.harvard.edu/abs/2023PhRvD.108d3520V) is used. -->
  <change type="encapsulate" path="transferFunction">
    <transferFunction value="bode2001">
      <scaleCutOffModel value="vogel23SpinHalf"/>
      <epsilon          value="1.000"          />
      <eta              value="5.000"          />
      <nu               value="1.049"          />
    </transferFunction>
  </change>

  <!-- Calculations of orbit, NFW scale radii, and halo spins should proceed using the original CDM models. Therefore, we need to
       provide the original dark matter-only mass distributions to the relevant classes. -->
  <!-- First append empty instances of the DMO mass distribution class to the virial orbits, Johnson et al. (2021) and Vitvitska
       et al. (2002) classes. -->
  <change type="append" path="virialOrbit">
    <darkMatterProfileDMO/>
  </change>
  <change type="append" path="darkMatterProfileScaleRadius/darkMatterProfileScaleRadius">
    <darkMatterProfileDMO/>
  </change>
  <change type="append" path="nodeOperator/nodeOperator[@value='haloAngularMomentumVitvitska2002']">
    <darkMatterProfileDMO/>
  </change>
  <!-- Now replace those empty instances with copies of the original CDM choices. -->
  <change   type="replaceWith"
	    path="virialOrbit/darkMatterProfileDMO"
	  target="darkMatterProfileDMO" />
  <change   type="replaceWith"
	    path="darkMatterProfileScaleRadius/darkMatterProfileScaleRadius/darkMatterProfileDMO"
	  target="darkMatterProfileDMO" />
  <change   type="replaceWith"
	    path="nodeOperator/nodeOperator[@value='haloAngularMomentumVitvitska2002']/darkMatterProfileDMO"
	  target="darkMatterProfileDMO" />

  <!-- Include prompt cusps -->
  <change type="replace" path="darkMatterProfileDMO/darkMatterProfileDMO">
    <darkMatterProfileDMO value="cuspNFW">
      <toleranceRelativeVelocityDispersion        value="1.0e-2"/>
      <toleranceRelativeVelocityDispersionMaximum value="1.0e-1"/>
    </darkMatterProfileDMO>
  </change>
  <change type="insertAfter" path="nodeOperator/nodeOperator[@value='darkMatterProfileScaleSet']">
    <nodeOperator value="darkMatterProfilePromptCusps">
      <alpha                 value="24.000"/>
      <beta                  value=" 7.300"/>
      <C                     value=" 0.800"/>
      <kappa                 value=" 4.500"/>
      <coefficientScatter    value=" 0.195"/>
      <nonConvergenceIsFatal value="false" />
      <!-- Halos in which no prompt cusp can form can not themselves have formed, and are pruned (below). This is the default,   -->
      <!-- but is set explicitly here so that the parameter migration which pins the original behavior for existing user      -->
      <!-- parameter files leaves these reference models on the new, more realistic, physics.                                 -->
      <requireCollapseBeforeHalo value="true" />
    </nodeOperator>
  </change>

  <!-- Prune halos in which no prompt cusp can form. Prompt cusp formation is, by definition, the formation event of a halo, so a
       halo for which the cusp collapse epoch would lie in its own future can not have formed. Such halos are labeled by the
       `darkMatterProfilePromptCusps` node operator during tree initialization, and are removed from the tree here. Primary
       progenitor status is not preserved: where the primary progenitor is pruned it is precisely because it could not have
       formed, so the surviving progenitor is the true primary progenitor. -->
  <change type="append" path="">
    <mergerTreeOperator value="pruneByFilter">
      <preservePrimaryProgenitor value="false"/>
      <galacticFilter value="labelled">
	<label value="promptCuspUnformed"/>
      </galacticFilter>
    </mergerTreeOperator>
  </change>

</changes>
